# ==== Backend ====
# Environment: development | production
APP_ENV=development
APP_NAME=InternFlow
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173

# Local Postgres (role/db created by setup scripts)
DATABASE_URL=postgresql+psycopg://internflow:internflow_dev@localhost:5432/internflow

# A minimum of 32 random bytes is recommended (openssl rand -base64 48)
JWT_SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# Email delivery (leave blank to log emails to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@internflow.local
SMTP_USE_TLS=true

# File storage: local | s3
STORAGE_BACKEND=local
UPLOAD_DIR=storage
MAX_UPLOAD_SIZE_MB=25
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Web push (VAPID) — optional, used for browser notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@internflow.local

# Comma-separated allowed browser origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO

# ==== Frontend (build-time) ====
# Leave empty for same-origin (dev proxy). Set the absolute backend origin when
# the frontend is served from a different host than the API.
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000